# P2's own settings. P2 holds NO bank-database URL, role or service account (see README, rule 1).

# P1 MCP server (docker compose service `p1-mcp`, streamable HTTP)
P1_MCP_URL=http://localhost:8001/mcp

# P2's local Postgres: policy store + LangGraph checkpoints. Contains no bank data.
STATE_DATABASE_URL=postgresql://p2:p2-local@localhost:5433/p2

# --- Models (OpenRouter) --------------------------------------------------------
OPENROUTER_API_KEY=

# --- Traces ---------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
